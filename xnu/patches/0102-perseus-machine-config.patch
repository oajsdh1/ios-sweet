 # Headers installed into System.framework/PrivateHeaders (userspace internal SDK only).
diff --git a/pexpert/pexpert/arm64/PERSEUS.h b/pexpert/pexpert/arm64/PERSEUS.h
new file mode 100644
index 0000000..perseus01
--- /dev/null
+++ b/pexpert/pexpert/arm64/PERSEUS.h
@@ -0,0 +1,21 @@
+/*
+ * Board config for the Xiaomi Mi MIX 3 ("perseus", Qualcomm SDM845 /
+ * Snapdragon 845). The MIX 3 is the same platform as the Mi MIX 2S
+ * ("polaris"): Kryo 385 = Cortex-A75 + Cortex-A55, ARMv8.2, no pointer
+ * authentication; the panel differs (1080x2340). As with POLARIS, everything
+ * board-specific lives in the device tree built by tools/mkadt.py, so this
+ * header only tags the configuration - the KERNEL_FLAGS for PERSEUS define
+ * ARM64_BOARD_CONFIG_SWEET too, which supplies the whole platform
+ * description, and 0104-perseus-platform-expert.patch matches
+ * 'xiaomi,perseus' / 'perseus,display' in iokit/KernelConfigTables.cpp.
+ */
+
+#ifndef _PEXPERT_ARM64_PERSEUS_H
+#define _PEXPERT_ARM64_PERSEUS_H
+
+#include <pexpert/arm64/SWEET.h>
+
+#define PERSEUS                        1
+#define SDM845                         1
+
+#endif /* ! _PEXPERT_ARM64_PERSEUS_H */
